# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key.
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_. Used only inside
# app/api/* route handlers to perform privileged writes (session/state
# validation, photo metadata, strip finalization) that must not be
# controllable directly from the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Name of the Supabase Storage bucket used for photobooth photos.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=photobooth

# Hours until a session + its photos expire. Default: 24
SESSION_EXPIRY_HOURS=24
